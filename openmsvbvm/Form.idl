import "oaidl.idl";
import "ocidl.idl";

// This is the CoClass definition for the Form object
[
	uuid(33AD4F38-6699-11CF-B70C-00AA0060D393),
	helpstring("Represents a Form window"),
]
coclass Form {
	[default] interface _Form;
	//[default, source] interface FormEvents; // TODO!
};

/*
 * This is the Interface definition for the _Form object.
 *
 * Unlike App.idl/VBGlobal.idl (hand-transcribed straight off real msvbvm60's own
 * _App/VBGlobal), this file's member list/order was reconstructed from a live dump of
 * the real _Form interface in C:\...\VB98\VB6.OLB (walked via ITypeLib/ITypeInfo)
 * rather than from disassembly of this project's own code. Every named member's
 * vtable slot below was derived from that dump's own oVft field (real byte offset =
 * oVft/2, slot = that/4). The whole point of expressing this as an actual MIDL-compiled
 * interface (rather than a hand-maintained "raw offset constant" like the old
 * kFormShowVtableOffset) is that the *compiler* now derives every member's vtable
 * offset from this declaration order, the same way it would for the real object --
 * get this file's member order right once, and every offset falls out correctly,
 * including ones this project doesn't otherwise care about yet.
 *
 * Slots with no confirmed real name/purpose (11 before Name, plus one-slot gaps
 * throughout -- almost all of these are a property's "other half", e.g. a
 * propput/propputref this dump didn't resolve a name for, or Automation's own
 * reserved slots) are padded with helpstring("Unknown exported method") placeholder
 * methods, exactly the same technique App.idl already uses for _App's own unresolved
 * slots (MissingNN) -- each one just needs to be *a* vtable entry, not a correct one.
 *
 * OLE-object-typed members (Picture, Icon, MouseIcon, Font, Palette) are kept as a
 * bare `long` rather than modeled as real IPictureDisp/IFontDisp objects, per explicit
 * instruction -- real support would need genuine stdole.Picture/StdFont marshaling,
 * out of scope here. Pure runtime/live-state members that were never a
 * design-time value (hWnd, hDC, CurrentX/Y, ActiveControl, Count, Controls) still get
 * a slot (their real vtable position must exist for everything after them to land
 * correctly) but are typed as plain `long` placeholders since nothing implements them.
 */
[
	uuid(33AD4F39-6699-11CF-B70C-00AA0060D393),
	helpstring("Represents a Form window"),
	hidden,
	nonextensible
]
interface _Form : IDispatch
{
