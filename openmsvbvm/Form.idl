			[in, optional] VARIANT y2,
			[in, optional] VARIANT width2,
			[in, optional] VARIANT height2,
			[in, optional] VARIANT Opcode
		);

	[helpstring("Returns, as a Long, the RGB color of the specified point on a form or picture box.")]
		HRESULT _stdcall Point(
			[in] float x,
			[in] float y,
			[out, retval] long* rhs
		);

	[helpstring("Sets the color of the specified point on an object.")]
		HRESULT _stdcall PSet(
			[in] float x,
			[in] float y,
			[in, optional] VARIANT Color
		);

	[helpstring("Defines the coordinate system for an object.")]
		HRESULT _stdcall Scale(
			[in, optional] VARIANT x1,
			[in, optional] VARIANT y1,
			[in, optional] VARIANT x2,
			[in, optional] VARIANT y2
		);

	[helpstring("Converts and returns a horizontal measurement in the units specified by the ScaleMode property.")]
		HRESULT _stdcall ScaleX(
			[in] float Value,
			[in, optional] VARIANT fromScale,
			[in, optional] VARIANT toScale,
			[out, retval] float* rhs
		);

	[helpstring("Converts and returns a vertical measurement in the units specified by the ScaleMode property.")]
		HRESULT _stdcall ScaleY(
			[in] float Value,
			[in, optional] VARIANT fromScale,
			[in, optional] VARIANT toScale,
			[out, retval] float* rhs
		);

	[helpstring("Returns the width, as it would be printed, of a text string using an object's current font.")]
		HRESULT _stdcall TextWidth(
			[in] BSTR str,
			[out, retval] float* rhs
		);

	[helpstring("Returns the height, as it would be printed, of a text string using an object's current font.")]
		HRESULT _stdcall TextHeight(
			[in] BSTR str,
			[out, retval] float* rhs
		);

	[helpstring("Forces the Validate event for the control that most recently lost the focus.")]
		HRESULT _stdcall ValidateControls([out, retval] VARIANT_BOOL* rhs);

	[helpstring("Manually invokes What's This Help mode.")]
		HRESULT _stdcall WhatsThisMode(void);

	[helpstring("Starts an OLE drag/drop operation explicitly, dispensing with automatic OLE drag/drop.")]
		HRESULT _stdcall OLEDrag(void);
};
